{
  "schemaVersion": 1,
  "name": "ollama-toolkit",
  "namespace": "dotknewt",
  "version": "0.1.0",
  "description": "Inspect, suggest, and explicitly approve individual Ollama model name cleanups.",
  "license": "MIT",
  "exports": [
    {"kind": "skill", "source": "skills/dotknewt-ollama-name-cleanup", "destination": "skills/dotknewt-ollama-name-cleanup"},
    {"kind": "asset", "source": "mcp/ollama", "destination": "mcp/ollama"}
  ],
  "requiredSkills": ["dotknewt-ollama-name-cleanup"],
  "mcp": [
    {"name": "dotknewt-ollama", "type": "local", "command": ["uv", "run", "--script"], "entrypoint": "mcp/ollama/server.py", "enabled": true}
  ],
  "dependencies": {"platforms": ["linux"], "executables": ["uv", "python3", "ollama"]}
}
