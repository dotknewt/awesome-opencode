{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotknewt.github.io/awesome-opencode/schemas/toolkit.schema.json",
  "title": "awesome-opencode toolkit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "namespace",
    "version",
    "description",
    "license",
    "exports",
    "requiredSkills",
    "mcp",
    "dependencies"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "$ref": "#/$defs/name" },
    "namespace": { "$ref": "#/$defs/name" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/export" }
    },
    "requiredSkills": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "mcp": {
      "type": "array",
      "items": { "$ref": "#/$defs/localMcp" }
    },
    "dependencies": { "$ref": "#/$defs/dependencies" }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\\\]+$"
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "destination"],
      "properties": {
        "kind": { "enum": ["skill", "agent", "command", "asset"] },
        "source": { "$ref": "#/$defs/relativePath" },
        "destination": { "$ref": "#/$defs/relativePath" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "skill" } }, "required": ["kind"] },
          "then": { "properties": { "destination": { "type": "string", "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "agent" } }, "required": ["kind"] },
          "then": { "properties": { "destination": { "type": "string", "pattern": "^agents/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "command" } }, "required": ["kind"] },
          "then": { "properties": { "destination": { "type": "string", "pattern": "^commands/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$" } } }
        }
      ]
    },
    "localMcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "command", "entrypoint", "enabled"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "const": "local" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "entrypoint": { "$ref": "#/$defs/relativePath" },
        "enabled": { "type": "boolean" }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "executables"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["linux", "darwin", "win32"] }
        },
        "executables": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        }
      }
    }
  }
}
